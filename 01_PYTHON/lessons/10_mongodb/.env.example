MONGODB_URI=mongodb+srv://UserDB:<db_password>@cluster0.dkili5s.mongodb.net/?appName=Cluster0
MONGODB_DB=demo_db
MONGODB_COLLECTION=demo_collection

# Copia este archivo a .env y completa la URI real.
# Si usas MongoDB Atlas con SRV, basta con pegar el string que te entrega Atlas.
# Si tu contraseña tiene caracteres especiales (&, @, #, /, etc.), escápalos con URL encoding.
# Ejemplo: contraseña "&TBgDa1dv7@taUAvgPjU" -> %26TBgDa1dv7%40taUAvgPjU
