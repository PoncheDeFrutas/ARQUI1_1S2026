# Template: RISC-V 64 en host Linux con QEMU (flujo multi-fuente)
# Copia este archivo como Makefile dentro de la leccion.

# ----------------------------------------------------------
# Toolchain
# ----------------------------------------------------------
AS      = riscv64-linux-gnu-as
LD      = riscv64-linux-gnu-ld
QEMU    = qemu-riscv64

# ----------------------------------------------------------
# Rutas y nombres de salida
# ----------------------------------------------------------
BUILD   = build
TARGET  = $(BUILD)/main

# ----------------------------------------------------------
# Fuentes
# ----------------------------------------------------------
MAIN_SRC = main.s
AUX_SRCS = $(filter-out $(MAIN_SRC), $(wildcard *.s))
SRCS     = $(MAIN_SRC) $(AUX_SRCS)
OBJS     = $(patsubst %.s,$(BUILD)/%.o,$(SRCS))

# ----------------------------------------------------------
# Flags
# ----------------------------------------------------------
ASFLAGS = -g
LDFLAGS =

# ----------------------------------------------------------
# Targets principales
# ----------------------------------------------------------

all: $(TARGET)

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/%.o: %.s | $(BUILD)
	$(AS) $(ASFLAGS) -o $@ $<

$(TARGET): $(OBJS)
	$(LD) $(LDFLAGS) -o $@ $(OBJS)

run: $(TARGET)
	$(QEMU) $(TARGET)

gdb: $(TARGET)
	@echo "Starting QEMU and waiting for GDB on port 1234..."
	$(QEMU) -g 1234 $(TARGET)

clean:
	rm -rf $(BUILD)

info:
	@echo "Targets disponibles:"
	@echo "  make        -> ensambla y enlaza el programa RISC-V"
	@echo "  make run    -> ejecuta el binario en QEMU"
	@echo "  make gdb    -> ejecuta QEMU y espera conexion de GDB (VS Code)"
	@echo "  make clean  -> elimina el directorio build/"
